APP_NAME="Face Attendance"
ENV="production"

MYSQL_HOST="mysql"
MYSQL_PORT=3306
MYSQL_USER="app"
MYSQL_PASSWORD="app_password"
MYSQL_DB="face_attendance"

FACE_MATCH_THRESHOLD=0.5

# Bootstrap admin (created on first start if missing)
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="admin123"
BOOTSTRAP_ADMIN_COMPANY_CODE="default"
BOOTSTRAP_ADMIN_COMPANY_NAME="Default Company"

# Bootstrap test accounts (created on first start if missing)
BOOTSTRAP_MANAGER_USERNAME="manager"
BOOTSTRAP_MANAGER_PASSWORD="manager123"
BOOTSTRAP_EMPLOYEE_USERNAME="employee"
BOOTSTRAP_EMPLOYEE_PASSWORD="employee123"
