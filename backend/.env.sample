APP_NAME="Face Attendance"
ENV="production"

MYSQL_HOST="mysql"
MYSQL_PORT=3306
MYSQL_USER="app"
MYSQL_PASSWORD="app_password"
MYSQL_DB="face_attendance"

FACE_MATCH_THRESHOLD=0.5
JWT_SECRET="replace_with_a_random_secret_at_least_32_chars"
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
AUTH_PUBLIC_REGISTRATION_ENABLED=0
FACE_UPLOAD_MAX_BYTES=5242880
ATTENDANCE_EVIDENCE_SPOOL_DIR="/tmp/attendance-evidence-spool"
ATTENDANCE_EVIDENCE_MAX_RETRIES=3
ATTENDANCE_EVIDENCE_BACKOFF_BASE_SECONDS=30
ATTENDANCE_EVIDENCE_WORKER_POLL_SECONDS=2
ATTENDANCE_EVIDENCE_CLEANUP_INTERVAL_SECONDS=86400
ATTENDANCE_EVIDENCE_PRESIGNED_EXPIRE_SECONDS=600
ATTENDANCE_EVIDENCE_DEFAULT_ENABLED=1
ATTENDANCE_EVIDENCE_DEFAULT_QUALITY=65
ATTENDANCE_EVIDENCE_DEFAULT_MAX_WIDTH=720
ATTENDANCE_EVIDENCE_DEFAULT_FORMAT="webp"
ATTENDANCE_EVIDENCE_DEFAULT_RETENTION_DAYS=30
MINIO_ENDPOINT="http://localhost:9010"
MINIO_PUBLIC_ENDPOINT="http://localhost:9010"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_REGION="us-east-1"
MINIO_BUCKET_ATTENDANCE="attendance"
MINIO_SECURE=0

# Bootstrap admin (created on first start if missing)
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="admin123"
BOOTSTRAP_ADMIN_COMPANY_CODE="default"
BOOTSTRAP_ADMIN_COMPANY_NAME="Default Company"

# Bootstrap test accounts (set enabled=1 to create on first start)
BOOTSTRAP_TEST_USERS_ENABLED=0
BOOTSTRAP_MANAGER_USERNAME="manager"
BOOTSTRAP_MANAGER_PASSWORD="manager123"
BOOTSTRAP_EMPLOYEE_USERNAME="employee"
BOOTSTRAP_EMPLOYEE_PASSWORD="employee123"
