APP_NAME="Face Attendance"
ENV="production"

MYSQL_HOST="mysql"
MYSQL_PORT=3306
MYSQL_USER="app"
MYSQL_PASSWORD="app_password"
MYSQL_DB="face_attendance"
MYSQL_ROOT_PASSWORD="root_password"

FACE_MATCH_THRESHOLD=0.5

FRONTEND_PORT=80

# JWT
JWT_SECRET="change_me"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend (invite link)
FRONTEND_BASE_URL="http://localhost:3000" 
INVITE_TOKEN_EXPIRE_MINUTES=4320

# SMTP (invite emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="abc@gmail.com"
SMTP_PASSWORD="abc"
SMTP_FROM="Face Attendance <no-reply@abc.com>"
SMTP_USE_STARTTLS=true

# ML service (internal)
ML_SERVICE_URL="http://ml:8001"
ML_SERVICE_TIMEOUT_SECONDS=15

# Bootstrap admin (created on first start if missing)
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="admin123"
BOOTSTRAP_ADMIN_COMPANY_CODE="default"
BOOTSTRAP_ADMIN_COMPANY_NAME="Default Company"

# Bootstrap test accounts (created on first start if missing)
BOOTSTRAP_MANAGER_USERNAME="manager"
BOOTSTRAP_MANAGER_PASSWORD="manager123"
BOOTSTRAP_EMPLOYEE_USERNAME="employee"
BOOTSTRAP_EMPLOYEE_PASSWORD="employee123"

VPS_APP_DIR=face-attendance

GHCR_TOKEN=personal_access_token_with_:read:packages   #Personal Access Token (PAT)
GHCR_USER=abc #user_name github
